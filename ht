<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Online Library</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome for icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    * {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>
<body class="bg-gray-50 font-sans min-h-screen flex flex-col">

  <!-- Header -->
  <header class="bg-white shadow-md border-b">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <i class="fas fa-book text-blue-600 text-3xl"></i>
        <h1 class="text-2xl font-semibold text-gray-800">My Digital Library</h1>
      </div>
      <div class="text-sm text-gray-600 font-medium">
        <span id="book-count" class="font-semibold">0</span> books available
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 max-w-7xl mx-auto px-6 py-8">

    <!-- Search Bar -->
    <div class="max-w-3xl mx-auto bg-white rounded-xl shadow-lg p-6 mb-8 transition-transform hover:scale-105 duration-200">
      <div class="flex flex-col md:flex-row gap-4 items-center">
        <input
          type="text"
          id="search-input"
          placeholder="Search books..."
          class="flex-1 p-4 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
        />
        <select
          id="search-type"
          class="w-full md:w-48 p-4 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
        >
          <option value="title">Title</option>
          <option value="author">Author</option>
          <option value="isbn">ISBN</option>
          <option value="keyword">Keywords</option>
        </select>
        <div class="flex space-x-2 mt-4 md:mt-0">
          <button
            onclick="searchBooks()"
            class="bg-blue-600 text-white px-6 py-3 rounded-xl shadow hover:bg-blue-700 transition font-semibold flex items-center"
          >
            <i class="fas fa-search mr-2"></i> Search
          </button>
          <button
            onclick="fetchBooksFromSheet()"
            class="bg-gray-500 text-white px-4 py-3 rounded-xl shadow hover:bg-gray-600 transition flex items-center"
          >
            <i class="fas fa-sync-alt"></i>
          </button>
        </div>
      </div>
      <!-- Loading indicator -->
      <div id="loading" class="hidden mt-4 flex items-center justify-center space-x-2 text-gray-600">
        <i class="fas fa-spinner fa-spin"></i>
        <span>Loading books...</span>
      </div>
      <!-- Error message -->
      <div id="error" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-lg text-red-600"></div>
    </div>

    <!-- Books Grid -->
    <div id="results" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"></div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden flex flex-col items-center justify-center py-16 text-center">
      <div class="text-gray-300 mb-4 text-6xl"><i class="fas fa-book-open"></i></div>
      <h3 class="text-xl font-semibold text-gray-700 mb-2">No books found</h3>
      <p class="text-gray-500 mb-4">Try different search terms</p>
      <button onclick="renderBooks(books)" class="bg-blue-600 text-white px-4 py-2 rounded-xl shadow hover:bg-blue-700 transition">
        Show All Books
      </button>
    </div>

  </main>

  <script>
    // Sample data for fallback
    const sampleBooks = [
      {
        id: 1,
        title: "The Great Gatsby",
        author: "F. Scott Fitzgerald",
        isbn: "978-0-7432-7356-5",
        year: "1925",
        cover_url: "https://via.placeholder.com/150x220/4F8A8B/FFFFFF?text=Gatsby",
        shelf_id: "A1-101",
        availability: true
      },
      {
        id: 2,
        title: "1984",
        author: "George Orwell",
        isbn: "978-0-452-28423-4",
        year: "1949",
        cover_url: "https://via.placeholder.com/150x220/8B4F47/FFFFFF?text=1984",
        shelf_id: "B2-205",
        availability: false
      },
      {
        id: 3,
        title: "To Kill a Mockingbird",
        author: "Harper Lee",
        isbn: "978-0-06-112008-4",
        year: "1960",
        cover_url: "https://via.placeholder.com/150x220/4A7C59/FFFFFF?text=Mockingbird",
        shelf_id: "C3-312",
        availability: true
      },
    ];

    let books = [];

    // Parse CSV text into rows
    function parseCSV(text) {
      const lines = text.trim().split('\n');
      const result = [];
      for (const line of lines) {
        const row = [];
        let current = '';
        let inQuotes = false;
        for (let i = 0; i < line.length; i++) {
          const char = line[i];
          if (char === '"') {
            inQuotes = !inQuotes;
          } else if (char === ',' && !inQuotes) {
            row.push(current);
            current = '';
          } else {
            current += char;
          }
        }
        row.push(current);
        result.push(row);
      }
      return result;
    }

    // Show/hide loading
    function showLoading() {
      document.getElementById('loading').classList.remove('hidden');
    }
    function hideLoading() {
      document.getElementById('loading').classList.add('hidden');
    }

    // Fetch books from Google Sheets CSV
    async function fetchBooksFromSheet() {
      const errorDiv = document.getElementById('error');
      const resultsDiv = document.getElementById('results');
      const emptyState = document.getElementById('empty-state');

      showLoading();
      resultsDiv.innerHTML = '';
      emptyState.classList.add('hidden');
      errorDiv.classList.add('hidden');

      // Replace with your actual Google Sheet CSV URL
      const SHEET_URL = 'YOUR_PUBLISHED_CSV_URL';

      // Use a CORS proxy if needed
      const proxyUrl = `https://corsproxy.io/?${encodeURIComponent(SHEET_URL)}`;

      try {
        const response = await fetch(proxyUrl);
        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        const csvText = await response.text();

        const rows = parseCSV(csvText);
        if (rows.length < 2) throw new Error('No data');

        const headers = rows[0].map(h => h.trim().toLowerCase());
        const dataRows = rows.slice(1);

        books = dataRows.map((row, index) => {
          const rowData = {};
          headers.forEach((header, i) => {
            rowData[header] = row[i] ? row[i].replace(/"/g, '').trim() : '';
          });
          return {
            id: index + 1,
            title: rowData['title'] || '',
            author: rowData['author'] || '',
            isbn: rowData['isbn'] || '',
            year: rowData['year'] || '',
            cover_url: rowData['cover_url'] || 'https://via.placeholder.com/150x220/cccccc/999999?text=No+Image',
            shelf_id: rowData['shelf_id'] || '',
            availability: rowData['availability'] && rowData['availability'].toLowerCase() === 'true'
          };
        });

        renderBooks(books);
        updateBookCount(books.length);
      } catch (error) {
        console.error('Error fetching CSV:', error);
        // fallback to sample data
        books = [...sampleBooks];
        renderBooks(books);
        updateBookCount(books.length);
        document.getElementById('error').innerHTML = `
          <div class="bg-orange-50 border border-orange-200 rounded-lg p-4 text-orange-600">
            <div class="flex items-center mb-2">
              <i class="fas fa-info-circle mr-2"></i>
              <span class="font-medium">Could not fetch data from Google Sheets. Showing demo books.</span>
            </div>
            <button onclick="fetchBooksFromSheet()" class="mt-2 bg-orange-100 text-orange-600 px-3 py-1 rounded hover:bg-orange-200 flex items-center">
              <i class="fas fa-retry mr-2"></i> Retry
            </button>
          </div>
        `;
        document.getElementById('error').classList.remove('hidden');
      } finally {
        hideLoading();
      }
    }

    // Render books grid
    function renderBooks(list) {
      const resultsDiv = document.getElementById('results');
      const emptyState = document.getElementById('empty-state');

      resultsDiv.innerHTML = '';
      emptyState.classList.add('hidden');

      updateBookCount(list.length);

      if (list.length === 0) {
        emptyState.classList.remove('hidden');
        return;
      }

      list.forEach((book) => {
        const card = document.createElement('div');
        card.className = 'bg-white rounded-xl shadow hover:shadow-lg transition p-4 flex flex-col';
        card.innerHTML = `
          <div class="flex-shrink-0 mb-4 flex justify-center">
            <img src="${book.cover_url}" alt="${book.title} cover" class="w-36 h-52 object-cover rounded-lg bg-gray-100" onerror="this.src='https://via.placeholder.com/150x220/cccccc/999999?text=No+Image'"/>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-1 line-clamp-2">${book.title}</h3>
          <p class="text-sm text-gray-600 mb-1">${book.author}</p>
          <p class="text-sm text-gray-500 mb-2">${book.year} • ${book.shelf_id}</p>
          <div class="flex items-center justify-between mt-auto">
            <div class="flex items-center space-x-2">
              <span class="${book.availability ? 'w-3 h-3 bg-green-500' : 'w-3 h-3 bg-red-500'} rounded-full"></span>
              <span class="${book.availability ? 'text-green-600' : 'text-red-600'} text-xs font-medium">${book.availability ? 'Available' : 'Checked Out'}</span>
            </div>
            <button class="text-blue-600 text-sm hover:underline" onclick="showBookDetails('${book.id}')">Details</button>
          </div>
        `;
        resultsDiv.appendChild(card);
      });
    }

    function showBookDetails(id) {
      const book = books.find(b => b.id == id);
      if (book) {
        alert(`Title: ${book.title}
Author: ${book.author}
Year: ${book.year}
ISBN: ${book.isbn}
Shelf: ${book.shelf_id}
Status: ${book.availability ? 'Available' : 'Checked Out'}`);
      }
    }

    // Update book count
    function updateBookCount(count) {
      document.getElementById('book-count').textContent = count;
    }

    // Search function
    function searchBooks() {
      const query = document.getElementById('search-input').value.trim().toLowerCase();
      const type = document.getElementById('search-type').value;
      const filtered = books.filter(book => {
        if (type === 'keyword') {
          return book.title.toLowerCase().includes(query) || book.author.toLowerCase().includes(query);
        }
        return String(book[type]).toLowerCase().includes(query);
      });
      if (filtered.length === 0) {
        document.getElementById('error').innerHTML = "No books found. Try different search terms.";
        document.getElementById('error').classList.remove('hidden');
      } else {
        document.getElementById('error').classList.add('hidden');
      }
      renderBooks(filtered);
    }

    // Initialize on page load
    window.addEventListener('load', () => {
      fetchBooksFromSheet();
    });
  </script>
</body>
</html>
